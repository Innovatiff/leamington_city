---
import Avatar from './Avatar.astro';
import ClickoutLink from './ClickoutLink';
import {
  formatCompensation,
  formatDate,
  pick,
  translate,
  truncate,
  type Job,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { businessPath } from '../lib/routes';

interface Props {
  job: Job;
  locale: Locale;
  index?: number;
  /** Compact cards omit the description and the apply button. */
  compact?: boolean;
}

const { job, locale, index = 0, compact = false } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const EMPLOYMENT_LABEL: Record<string, MessageKey> = {
  full_time: 'job.fullTime',
  part_time: 'job.partTime',
  seasonal: 'job.seasonal',
  contract: 'job.contract',
  temporary: 'job.temporary',
};
---

<li id={`job-${job.id}`} class="h-full" style={`--i:${index}`}>
  <article class="card flex h-full flex-col p-4">
    <div class="flex items-start gap-3">
      <Avatar
        name={job.business.name}
        logoUrl={job.business.logoUrl}
        seed={job.business.slug}
      />
      <div class="min-w-0 flex-1">
        <h3 class="text-[15px] font-bold leading-snug text-ink-900">
          {pick(job.title, locale)}
        </h3>
        <a
          href={businessPath(job.business, locale)}
          class="mt-0.5 block truncate text-sm text-ink-600 underline-offset-2 hover:text-brand-700 hover:underline"
        >
          {job.business.name}
        </a>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-1.5">
      <span class="badge bg-ink-100 text-ink-700">
        {t(EMPLOYMENT_LABEL[job.employmentType] ?? 'job.partTime')}
      </span>
      {
        job.compensation && (
          <span class="badge bg-leaf-50 text-leaf-700">
            {formatCompensation(job.compensation, locale)} {t('job.perHour')}
          </span>
        )
      }
    </div>

    {
      !compact && (
        <p class="mt-3 text-sm text-ink-600">
          {truncate(pick(job.description, locale), 180)}
        </p>
      )
    }

    <div class="mt-auto pt-3">
      <p class="text-[11px] font-medium text-ink-400">
        {t('job.postedOn', { date: formatDate(job.postedAt, locale) })}
      </p>

      {
        !compact && (job.applyUrl || job.applyEmail) && (
          <div class="mt-2.5">
            <ClickoutLink
              client:visible
              targetType="job"
              targetId={job.id}
              fallbackUrl={job.applyUrl ?? `mailto:${job.applyEmail}`}
              locale={locale}
              source="directory"
              label={t('job.apply')}
              className="btn-secondary w-full"
            />
          </div>
        )
      }
    </div>
  </article>
</li>
