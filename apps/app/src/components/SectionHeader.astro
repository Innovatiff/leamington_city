---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
}

const { title, subtitle, eyebrow, href, linkLabel } = Astro.props;
---

<div class="flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-title mt-1">{title}</h2>
    {subtitle && <p class="mt-1 text-sm text-ink-600">{subtitle}</p>}
  </div>

  {
    href && linkLabel && (
      <a
        href={href}
        class="shrink-0 whitespace-nowrap text-sm font-semibold text-brand-700
          underline-offset-4 hover:underline"
      >
        {linkLabel} →
      </a>
    )
  }
</div>
