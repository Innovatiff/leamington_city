---
import { translate, type Business, type Locale } from '@leamington/shared';

interface Props {
  business: Business;
  locale: Locale;
}

const { business, locale } = Astro.props;

/*
 * OpenStreetMap rather than the Google Maps Embed API: the Google embed needs
 * an API key, which would mean a key in the client bundle and a billable call
 * on every page view of a directory whose whole point is being cheap to serve.
 * OSM's embed needs neither, and the "open in Maps" link below still hands off
 * to whatever map app the phone actually has.
 */
const DELTA = 0.004; // ~450m — close enough to see the street.
const geo = business.geo;

const addressLine = [business.address.line1, business.address.line2]
  .filter(Boolean)
  .join(', ');
const cityLine = [
  business.address.city,
  business.address.province,
  business.address.postalCode,
]
  .filter(Boolean)
  .join(' ');

const query = encodeURIComponent(
  [business.name, business.address.line1, business.address.city, business.address.province]
    .filter(Boolean)
    .join(', '),
);

const embedSrc = geo
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${geo.lng - DELTA}%2C${
      geo.lat - DELTA
    }%2C${geo.lng + DELTA}%2C${geo.lat + DELTA}&layer=mapnik&marker=${geo.lat}%2C${geo.lng}`
  : null;

// Geo coordinates open the exact pin; without them, fall back to a text search.
const externalHref = geo
  ? `https://www.google.com/maps/search/?api=1&query=${geo.lat},${geo.lng}`
  : `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<section class="mt-10">
  <h2 class="text-sm font-bold uppercase tracking-wider text-ink-500">
    {translate(locale, 'business.map')}
  </h2>

  {/*
    The address is part of the card, not something the map replaces. A
    third-party iframe can fail — blocked, offline, rate-limited — and when it
    does the card still says where the place is and still offers a way there,
    rather than becoming a broken grey box.
  */}
  <div class="mt-3 overflow-hidden rounded-[--radius-card] border border-ink-200">
    {
      embedSrc && (
        <iframe
          src={embedSrc}
          title={`${translate(locale, 'business.map')} — ${business.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-56 w-full border-0 bg-ink-100"
        />
      )
    }

    <div class="flex items-center gap-3 border-t border-ink-200 bg-white p-4">
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6 shrink-0 text-brand-600"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="M12 21s7-5.3 7-10.6A7 7 0 0 0 5 10.4C5 15.7 12 21 12 21Z"></path>
        <circle cx="12" cy="10.3" r="2.4"></circle>
      </svg>
      <div class="min-w-0 flex-1">
        <p class="truncate font-semibold text-ink-900">{addressLine}</p>
        <p class="truncate text-sm text-ink-600">{cityLine}</p>
      </div>
      <a
        href={externalHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary shrink-0"
      >
        {translate(locale, 'business.viewOnMap')}
      </a>
    </div>
  </div>
</section>
