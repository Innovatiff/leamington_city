---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  alternateLocale,
  localizedPath,
  translate,
  type BusinessCategory,
  type Locale,
} from '@leamington/shared';
import { htmlLang } from '../lib/seo';
import { SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /**
   * Path without the locale prefix, e.g. `/restaurants/erie-shore-diner`.
   * Both locale URLs are derived from it, which keeps the hreflang pair
   * self-consistent on every page.
   */
  path: string;
  image?: string | null;
  jsonLd?: string[];
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'business.business';
  /** Categories with listings, for the footer. */
  footerCategories?: BusinessCategory[];
  /** Full-bleed pages manage their own top spacing. */
  bleed?: boolean;
}

const {
  locale,
  title,
  description,
  path,
  image = null,
  jsonLd = [],
  noindex = false,
  ogType = 'website',
  footerCategories = [],
  bleed = false,
} = Astro.props;

const site = Astro.site?.toString() ?? SITE_URL;
const other = alternateLocale(locale);
const canonical = new URL(localizedPath(locale, path), site).toString();
const alternateHref = new URL(localizedPath(other, path), site).toString();
const xDefault = new URL(localizedPath('en', path), site).toString();
const absoluteImage = image ? new URL(image, site).toString() : null;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Both languages are equal citizens; x-default points at English. */}
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Leamington" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
    <meta property="og:locale:alternate" content={htmlLang(other).replace('-', '_')} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && <meta property="og:image:width" content="1200" />}
    {absoluteImage && <meta property="og:image:alt" content={title} />}

    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    <meta name="theme-color" content="#a8341f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Listing photography, the map embed and analytics are the only third
        parties a page talks to. Warm the image host early — it is the only one
        on the critical path. */}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://www.openstreetmap.org" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    {/*
      Listing photography is remote, so some of it will eventually 404 — a
      business changes host, a URL rots, a CDN blocks a referrer. One capturing
      listener swaps any failed image for its generated category cover, so the
      page degrades to the local artwork instead of showing a broken icon.
      `error` does not bubble from <img>, hence the capture phase.
    */}
    <script is:inline>
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (!(target instanceof HTMLImageElement)) return;
          const fallback = target.dataset.fallback;
          if (!fallback || target.src.endsWith(fallback)) return;
          target.src = fallback;
          target.removeAttribute('srcset');
        },
        true,
      );
    </script>

    {jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={block} />)}
  </head>

  <body class="flex min-h-dvh flex-col bg-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60]
        focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:shadow-[--shadow-lift]"
    >
      {translate(locale, 'common.more')}
    </a>

    {/*
      Analytics. A bundled module script rather than an island: there is no UI
      to hydrate, and this way it is deferred by default and shared across every
      page. `initAnalytics` decides whether it actually starts — see the module
      for the opt-out and failure handling.
    */}
    <script>
      import { initAnalytics } from '../lib/analytics';

      void initAnalytics();
    </script>

    <SiteHeader locale={locale} path={path} />

    <main id="main" class:list={['flex-1', bleed ? '' : 'shell py-6 sm:py-10']}>
      <slot />
    </main>

    <SiteFooter locale={locale} categories={footerCategories} />
  </body>
</html>
