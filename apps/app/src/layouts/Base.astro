---
import '../styles/global.css';
import { alternateLocale, localizedPath, translate, type Locale } from '@leamington/shared';
import { htmlLang } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without the locale prefix, e.g. `/business/erie-shore-diner`. */
  path: string;
  image?: string | null;
  jsonLd?: string[];
  noindex?: boolean;
}

const { locale, title, description, path, image = null, jsonLd = [], noindex = false } =
  Astro.props;

const site = Astro.site?.toString() ?? 'https://leamington.city';
const other = alternateLocale(locale);
const canonical = new URL(localizedPath(locale, path), site).toString();
const alternateHref = new URL(localizedPath(other, path), site).toString();
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);

const nav = [
  { href: '/', key: 'nav.feed' },
  { href: '/offers', key: 'nav.offers' },
  { href: '/jobs', key: 'nav.jobs' },
  { href: '/businesses', key: 'nav.directory' },
] as const;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Both languages are equal citizens; x-default points at English. */}
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternateHref} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizedPath('en', path), site).toString()}
    />

    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#b23b2f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={block} />
      ))
    }
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3"
    >
      {t('common.more')}
    </a>

    <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-2 px-4 py-2">
        <a href={localizedPath(locale, '/')} class="flex font-bold text-brand-600">
          Leamington
        </a>
        <a
          href={new URL(localizedPath(other, path), site).pathname}
          class="flex rounded-lg px-3 py-2 text-sm font-semibold text-neutral-700"
          hreflang={other}
          rel="alternate"
        >
          {translate(other, 'common.languageName')}
        </a>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-4">
      <slot />
    </main>

    <nav
      class="sticky bottom-0 border-t border-neutral-200 bg-white"
      aria-label={t('nav.menu')}
    >
      <ul class="mx-auto flex max-w-3xl">
        {
          nav.map((item) => {
            const href = localizedPath(locale, item.href);
            const current = Astro.url.pathname === href;
            return (
              <li class="flex-1">
                <a
                  href={href}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'flex flex-col justify-center py-3 text-center text-xs font-semibold',
                    current ? 'text-brand-600' : 'text-neutral-600',
                  ]}
                >
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </body>
</html>
