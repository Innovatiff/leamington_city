---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OfferCard from '../components/OfferCard.astro';
import JobCard from '../components/JobCard.astro';
import LiveStats from '../components/LiveStats';
import OpenNowRail from '../components/OpenNowRail';
import {
  BUSINESS_CATEGORIES,
  categoryMessageKey,
  localizedPath,
  translate,
  translateCount,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { getBusinesses, getLiveOffers, getOpenJobs } from '../lib/content';
import { businessPath, categoryPath, ROUTES } from '../lib/routes';
import { businessCover, categoryCover, HERO_COVER } from '../lib/covers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const [businesses, offers, jobs] = await Promise.all([
  getBusinesses(),
  getLiveOffers(),
  getOpenJobs(),
]);

// Categories in enum order, so eating, shopping and services stay grouped.
const counts = new Map<string, number>();
for (const business of businesses) {
  counts.set(business.category, (counts.get(business.category) ?? 0) + 1);
}
const categories = BUSINESS_CATEGORIES.filter((category) => (counts.get(category) ?? 0) > 0);

const featured = [...offers]
  .sort((a, b) => Number(b.featured) - Number(a.featured) || a.endsAt.getTime() - b.endsAt.getTime())
  .slice(0, 6);

const newest = [...businesses]
  .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())
  .slice(0, 4);

const latestJobs = jobs.slice(0, 4);

// The Open Now rail is rendered client-side from this payload — which places
// are open depends on the minute the page is read, not the minute it was built.
const openCandidates = businesses.slice(0, 60).map((business) => ({
  slug: business.slug,
  name: business.name,
  href: businessPath(business, locale),
  cover: businessCover(business),
  category: t(categoryMessageKey(business.category)),
  hours: business.hours,
}));
---

<Base
  locale={locale}
  path={ROUTES.home}
  title={`${t('home.heroTitle')} · Leamington, Ontario`}
  description={t('home.heroSubtitle')}
  image={HERO_COVER}
  footerCategories={categories}
  bleed
>
  {/* ------------------------------------------------------------------ hero */}
  <section class="relative isolate overflow-hidden">
    <img
      src={HERO_COVER}
      alt=""
      width="1800"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    {/* Two scrims rather than one: a left-weighted wash keeps the headline
        legible, and a soft bottom fade carries the eye into the page. The
        artwork stays visible on the right instead of being crushed flat. */}
    {/* One left-weighted scrim, kept as light as the contrast checker allows.
        An earlier pass stacked two and flattened the artwork to brown. */}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/78 via-ink-950/40 to-transparent"
    >
    </div>

    <div class="shell py-16 sm:py-24 lg:py-28">
      <p class="eyebrow text-brand-200">Leamington, Ontario</p>
      <h1
        class="text-shadow-hero mt-2 max-w-3xl text-4xl font-extrabold leading-[1.05]
          text-white sm:text-5xl lg:text-6xl"
      >
        {t('home.heroTitle')}
      </h1>
      <p class="text-shadow-hero mt-4 max-w-xl text-base text-white/85 sm:text-lg">
        {t('home.heroSubtitle')}
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={localizedPath(locale, ROUTES.search)} class="btn-primary btn-lg">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.2-3.2" stroke-linecap="round"></path>
          </svg>
          {t('home.searchCta')}
        </a>
        <a
          href={localizedPath(locale, ROUTES.directory)}
          class="btn btn-lg border border-white/25 bg-white/10 text-white backdrop-blur-sm
            hover:bg-white/20"
        >
          {t('home.browseCta')}
        </a>
      </div>

      <div class="mt-10 max-w-2xl">
        <LiveStats
          client:load
          locale={locale}
          businesses={businesses.length}
          offers={offers.length}
          jobs={jobs.length}
          hours={businesses.map((business) => business.hours)}
        />
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- open now */}
  <section class="shell border-b border-ink-100 py-8">
    <SectionHeader
      eyebrow={t('nav.feed')}
      title={t('home.openNowTitle')}
      subtitle={t('home.openNowSubtitle')}
    />
    <div class="mt-4">
      <OpenNowRail client:load locale={locale} items={openCandidates} />
    </div>
  </section>

  {/* ----------------------------------------------------------------- deals */}
  {
    featured.length > 0 && (
      <section class="shell py-10">
        <SectionHeader
          eyebrow={t('offer.title')}
          title={t('home.dealsTitle')}
          subtitle={t('home.dealsSubtitle')}
          href={localizedPath(locale, ROUTES.offers)}
          linkLabel={t('home.viewAll')}
        />
        <ul class="stagger mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((offer, index) => (
            <OfferCard offer={offer} locale={locale} index={index} />
          ))}
        </ul>
      </section>
    )
  }

  {/* ------------------------------------------------------------ categories */}
  <section class="bg-ink-50 py-12">
    <div class="shell">
      <SectionHeader
        eyebrow={t('nav.directory')}
        title={t('home.categoriesTitle')}
        subtitle={t('home.categoriesSubtitle')}
        href={localizedPath(locale, ROUTES.directory)}
        linkLabel={t('home.viewAll')}
      />

      <ul class="stagger mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          categories.map((category, index) => (
            <li style={`--i:${index}`}>
              <a
                href={categoryPath(category, locale)}
                class="card card-interactive group block"
              >
                <div class="cover aspect-[4/3]">
                  <img
                    src={categoryCover(category)}
                    alt=""
                    width="320"
                    height="240"
                    loading="lazy"
                    decoding="async"
                    class="card-zoom"
                  />
                  <div class="absolute inset-x-0 bottom-0 p-3">
                    <p class="text-shadow-hero text-sm font-bold leading-tight text-white">
                      {t(categoryMessageKey(category))}
                    </p>
                    <p class="text-shadow-hero text-[11px] font-medium text-white/80">
                      {translateCount(locale, 'category.countOne', 'category.count', counts.get(category) ?? 0)}
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------------ jobs */}
  {
    latestJobs.length > 0 && (
      <section class="shell py-12">
        <SectionHeader
          eyebrow={t('job.title')}
          title={t('home.jobsTitle')}
          subtitle={t('home.jobsSubtitle')}
          href={localizedPath(locale, ROUTES.jobs)}
          linkLabel={t('home.viewAll')}
        />
        <ul class="stagger mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {latestJobs.map((job, index) => (
            <JobCard job={job} locale={locale} index={index} compact />
          ))}
        </ul>
      </section>
    )
  }

  {/* ------------------------------------------------------------------- new */}
  {
    newest.length > 0 && (
      <section class="shell pb-12">
        <SectionHeader eyebrow={t('nav.directory')} title={t('home.newTitle')} />
        <ul class="stagger mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {newest.map((business, index) => (
            <BusinessCard business={business} locale={locale} index={index} />
          ))}
        </ul>
      </section>
    )
  }

  {/* ----------------------------------------------------------------- owner */}
  <section class="shell pb-16">
    <div
      class="relative overflow-hidden rounded-3xl bg-ink-900 px-6 py-10 text-white sm:px-10 sm:py-12"
    >
      <div
        class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-600/40 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-xl">
        <h2 class="text-2xl font-extrabold sm:text-3xl">{t('home.ownerTitle')}</h2>
        <p class="mt-2 text-white/75">{t('home.ownerBody')}</p>
        <a href={ROUTES.portal} class="btn-primary btn-lg mt-6" rel="noopener">
          {t('home.ownerCta')}
        </a>
      </div>
    </div>
  </section>
</Base>
