---
import Base from '../layouts/Base.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OpenNowFilter from '../components/OpenNowFilter';
import {
  categoryMessageKey,
  translate,
  type Business,
  type BusinessCategory,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { businessPath, categoryPathBare } from '../lib/routes';
import { serializeJsonLd } from '../lib/seo';

interface Props {
  locale: Locale;
  category: BusinessCategory;
  businesses: Business[];
}

const { locale, category, businesses } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const site = Astro.site?.toString() ?? 'https://leamington.city';
const categoryName = t(categoryMessageKey(category));

// An ItemList makes the category page itself eligible for a rich result, and
// it is cheap: the businesses are already in hand.
const itemList = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${categoryName} · Leamington`,
  numberOfItems: businesses.length,
  itemListElement: businesses.map((business, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(businessPath(business, locale), site).toString(),
    name: business.name,
  })),
});

const countLabel =
  businesses.length === 1
    ? t('search.oneResult')
    : t('search.resultCount', { count: businesses.length });
const description = `${countLabel} — ${categoryName}, Leamington, Ontario.`;
---

<Base
  locale={locale}
  path={categoryPathBare(category)}
  title={`${categoryName} · Leamington`}
  description={description}
  jsonLd={[itemList]}
>
  <h1 class="text-2xl font-bold text-neutral-900">{categoryName}</h1>
  <p class="mt-1 text-sm text-neutral-600">{countLabel}</p>

  <div class="mt-3">
    <OpenNowFilter client:visible locale={locale} />
  </div>

  <ul class="mt-4 space-y-2">
    {businesses.map((business) => <BusinessCard business={business} locale={locale} />)}
  </ul>

  {businesses.length === 0 && <p class="mt-8 text-neutral-600">{t('common.empty')}</p>}
</Base>
