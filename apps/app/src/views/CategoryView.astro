---
import Base from '../layouts/Base.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OpenNowFilter from '../components/OpenNowFilter';
import {
  BUSINESS_CATEGORIES,
  categoryMessageKey,
  localizedPath,
  translate,
  translateCount,
  type Business,
  type BusinessCategory,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { businessPath, categoryPath, categoryPathBare, ROUTES } from '../lib/routes';
import { serializeJsonLd } from '../lib/seo';
import { categoryCover } from '../lib/covers';
import { SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
  category: BusinessCategory;
  businesses: Business[];
  /** Categories with listings, for the sibling rail and the footer. */
  siblings: BusinessCategory[];
}

const { locale, category, businesses, siblings } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const site = Astro.site?.toString() ?? SITE_URL;
const categoryName = t(categoryMessageKey(category));
const cover = categoryCover(category);

// An ItemList makes the category page itself eligible for a rich result, and
// it is cheap: the businesses are already in hand.
const itemList = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${categoryName} · Leamington`,
  numberOfItems: businesses.length,
  itemListElement: businesses.map((business, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(businessPath(business, locale), site).toString(),
    name: business.name,
  })),
});

const countLabel = translateCount(locale, 'category.countOne', 'category.count', businesses.length);
const description = `${countLabel} — ${categoryName}, Leamington, Ontario.`;
const ordered = BUSINESS_CATEGORIES.filter((entry) => siblings.includes(entry));
---

<Base
  locale={locale}
  path={categoryPathBare(category)}
  title={`${categoryName} · Leamington`}
  description={description}
  image={cover}
  jsonLd={[itemList]}
  footerCategories={siblings}
  bleed
>
  {/* Category banner: the page should announce what it is before the list. */}
  <section class="relative isolate overflow-hidden">
    <img
      src={cover}
      alt=""
      width="1200"
      height="400"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/85 to-ink-950/45"></div>

    <div class="shell py-10 sm:py-14">
      <h1 class="text-shadow-hero text-3xl font-extrabold text-white sm:text-4xl">
        {categoryName}
      </h1>
      <p class="text-shadow-hero mt-1.5 text-sm font-medium text-white/80">
        {countLabel} · Leamington, Ontario
      </p>
    </div>
  </section>

  {/* Sibling categories, so a dead end is never a dead end. */}
  <nav
    class="no-scrollbar sticky top-16 z-30 flex gap-2 overflow-x-auto border-b border-ink-100
      bg-white/90 px-4 py-3 backdrop-blur-md sm:px-6"
    aria-label={t('footer.categories')}
  >
    {
      ordered.map((entry) => (
        <a
          href={categoryPath(entry, locale)}
          aria-current={entry === category ? 'page' : undefined}
          class:list={['chip', entry === category && 'chip-active']}
        >
          {t(categoryMessageKey(entry))}
        </a>
      ))
    }
  </nav>

  <div class="shell py-6">
    <OpenNowFilter client:visible locale={locale} />

    <ul class="stagger mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        businesses.map((business, index) => (
          <BusinessCard
            business={business}
            locale={locale}
            index={index}
            eager={index < 3}
          />
        ))
      }
    </ul>

    {businesses.length === 0 && <p class="py-16 text-center text-ink-600">{t('common.empty')}</p>}
  </div>

  {/* A category with four listings leaves a lot of empty page above the
      footer. Closing with somewhere to go is better than closing with a void. */}
  <section class="border-t border-ink-100 bg-ink-50 py-12">
    <div class="shell">
      <h2 class="section-title">{t('home.categoriesTitle')}</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          ordered
            .filter((entry) => entry !== category)
            .map((entry) => (
              <li>
                <a href={categoryPath(entry, locale)} class="chip">
                  {t(categoryMessageKey(entry))}
                </a>
              </li>
            ))
        }
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={localizedPath(locale, ROUTES.search)} class="btn-primary">
          {t('home.searchCta')}
        </a>
        <a href={localizedPath(locale, ROUTES.directory)} class="btn-secondary">
          {t('home.browseCta')}
        </a>
      </div>
    </div>
  </section>
</Base>
