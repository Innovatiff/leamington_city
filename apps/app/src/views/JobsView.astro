---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { translate, type Locale, type MessageKey } from '@leamington/shared';
import { getBusinesses, getOpenJobs } from '../lib/content';
import { jobJsonLd, serializeJsonLd } from '../lib/seo';
import { ROUTES } from '../lib/routes';
import { SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);
const site = Astro.site?.toString() ?? SITE_URL;

const [jobs, businesses] = await Promise.all([getOpenJobs(), getBusinesses()]);
const categories = [...new Set(businesses.map((business) => business.category))];
---

<Base
  locale={locale}
  path={ROUTES.jobs}
  title={`${t('job.title')} · Leamington`}
  description={t('home.jobsSubtitle')}
  footerCategories={categories}
  jsonLd={jobs.slice(0, 20).map((job) => serializeJsonLd(jobJsonLd(job, locale, site)))}
>
  <header>
    <p class="eyebrow">{t('nav.jobs')}</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
      {t('home.jobsTitle')}
    </h1>
    <p class="mt-2 max-w-xl text-ink-600">{t('home.jobsSubtitle')}</p>
    <p class="mt-1 text-sm font-semibold text-ink-500">
      {t('search.resultCount', { count: jobs.length })}
    </p>
  </header>

  {
    jobs.length === 0 && (
      <p class="mt-16 rounded-2xl bg-ink-50 py-16 text-center text-ink-600">
        {t('common.empty')}
      </p>
    )
  }

  <ul class="stagger mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {jobs.map((job, index) => <JobCard job={job} locale={locale} index={index} />)}
  </ul>
</Base>
