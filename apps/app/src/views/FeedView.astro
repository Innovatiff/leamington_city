---
import Base from '../layouts/Base.astro';
import {
  formatDate,
  localizedPath,
  pick,
  translate,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { getFeedDay, getLiveOffers } from '../lib/content';
import { businessPath, ROUTES } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

// One document read. Per CLAUDE.md the feed never fans out — if the scheduled
// builder has not run yet we fall back to live offers rather than N+1.
const feedDay = await getFeedDay();
const fallbackOffers = feedDay ? [] : await getLiveOffers();
const items = feedDay?.items ?? [];
---

<Base
  locale={locale}
  path={ROUTES.home}
  title={`${t('feed.title')} · Leamington`}
  description={t('feed.subtitle')}
>
  <h1 class="text-2xl font-bold text-neutral-900">{t('feed.title')}</h1>
  <p class="mt-1 text-sm text-neutral-600">{t('feed.subtitle')}</p>

  {
    items.length === 0 && fallbackOffers.length === 0 && (
      <p class="mt-8 rounded-xl bg-neutral-50 p-6 text-center text-neutral-600">
        {t('feed.empty')}
      </p>
    )
  }

  <ul class="mt-4 space-y-3">
    {
      items.map((item) => (
        <li>
          <a href={localizedPath(locale, item.href)} class="card flex gap-3">
            {item.imageUrl && (
              <img
                src={item.imageUrl}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
                class="h-14 w-14 shrink-0 rounded-lg object-cover"
              />
            )}
            <div class="min-w-0 flex-1">
              <h2 class="font-semibold text-neutral-900">{pick(item.title, locale)}</h2>
              <p class="truncate text-sm text-neutral-600">{pick(item.subtitle, locale)}</p>
              {item.endsAt && (
                <p class="mt-1 text-xs text-neutral-500">
                  {t('feed.endsOn', { date: formatDate(item.endsAt, locale) })}
                </p>
              )}
            </div>
          </a>
        </li>
      ))
    }

    {
      fallbackOffers.map((offer) => (
        <li>
          <a
            href={`${businessPath(offer.business, locale)}#offer-${offer.id}`}
            class="card"
          >
            <h2 class="font-semibold text-neutral-900">{pick(offer.title, locale)}</h2>
            <p class="truncate text-sm text-neutral-600">{offer.business.name}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
