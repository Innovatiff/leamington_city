---
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import { translate, type Locale, type MessageKey } from '@leamington/shared';
import { getBusinesses, getLiveOffers } from '../lib/content';
import { offerJsonLd, serializeJsonLd } from '../lib/seo';
import { ROUTES } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);
const site = Astro.site?.toString() ?? 'https://leamington.city';

const [offers, businesses] = await Promise.all([getLiveOffers(), getBusinesses()]);
const categories = [...new Set(businesses.map((business) => business.category))];

// Featured first, then whatever ends soonest — urgency is the whole point of a
// deals page, and a deal ending tonight matters more than one running all month.
const ordered = [...offers].sort(
  (a, b) =>
    Number(b.featured) - Number(a.featured) || a.endsAt.getTime() - b.endsAt.getTime(),
);
---

<Base
  locale={locale}
  path={ROUTES.offers}
  title={`${t('offer.title')} · Leamington`}
  description={t('home.dealsSubtitle')}
  footerCategories={categories}
  jsonLd={ordered
    .slice(0, 20)
    .map((offer) => serializeJsonLd(offerJsonLd(offer, locale, site)))}
>
  <header>
    <p class="eyebrow">{t('nav.offers')}</p>
    <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
      {t('home.dealsTitle')}
    </h1>
    <p class="mt-2 max-w-xl text-ink-600">{t('home.dealsSubtitle')}</p>
    <p class="mt-1 text-sm font-semibold text-ink-500">
      {t('search.resultCount', { count: ordered.length })}
    </p>
  </header>

  {
    ordered.length === 0 && (
      <p class="mt-16 rounded-2xl bg-ink-50 py-16 text-center text-ink-600">
        {t('feed.empty')}
      </p>
    )
  }

  <ul class="stagger mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {ordered.map((offer, index) => <OfferCard offer={offer} locale={locale} index={index} />)}
  </ul>
</Base>
