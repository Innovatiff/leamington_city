---
import Base from '../layouts/Base.astro';
import BusinessCard from '../components/BusinessCard.astro';
import OpenNowFilter from '../components/OpenNowFilter';
import {
  BUSINESS_CATEGORIES,
  categoryMessageKey,
  translate,
  type Locale,
  type MessageKey,
} from '@leamington/shared';
import { getBusinessesByCategory } from '../lib/content';
import { categoryPath, ROUTES } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const grouped = await getBusinessesByCategory();
// Enum order, not alphabetical — it groups eating, shopping and services
// together, which is how someone scans a directory.
const present = BUSINESS_CATEGORIES.filter((category) => (grouped.get(category) ?? []).length > 0);
const total = [...grouped.values()].reduce((sum, list) => sum + list.length, 0);

/** Only the first few per category; the category page has the rest. */
const PREVIEW = 5;
---

<Base
  locale={locale}
  path={ROUTES.directory}
  title={`${t('nav.directory')} · Leamington`}
  description={t('feed.subtitle')}
>
  <h1 class="text-2xl font-bold text-neutral-900">{t('nav.directory')}</h1>
  <p class="mt-1 text-sm text-neutral-600">
    {t('search.resultCount', { count: total })}
  </p>

  <div class="mt-3">
    <OpenNowFilter client:visible locale={locale} />
  </div>

  {total === 0 && <p class="mt-8 text-neutral-600">{t('common.empty')}</p>}

  {
    present.map((category) => {
      const businesses = grouped.get(category) ?? [];
      const categoryName = t(categoryMessageKey(category));
      return (
        <section class="mt-6">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="text-sm font-bold uppercase tracking-wide text-neutral-500">
              {categoryName}
            </h2>
            <a href={categoryPath(category, locale)} class="text-sm text-brand-600 underline">
              {t('common.more')}
            </a>
          </div>
          <ul class="mt-2 space-y-2">
            {businesses.slice(0, PREVIEW).map((business) => (
              <BusinessCard business={business} locale={locale} />
            ))}
          </ul>
          {businesses.length > PREVIEW && (
            <a
              href={categoryPath(category, locale)}
              class="mt-2 block text-sm text-brand-600 underline"
            >
              {t('search.resultCount', { count: businesses.length })}
            </a>
          )}
        </section>
      );
    })
  }
</Base>
