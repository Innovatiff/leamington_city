---
import Base from '../layouts/Base.astro';
import SearchIsland from '../components/SearchIsland';
import { localizedPath, translate, type Locale, type MessageKey } from '@leamington/shared';
import { getBusinesses } from '../lib/content';
import { ROUTES } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: MessageKey) => translate(locale, key);
const businesses = await getBusinesses();
const categories = [...new Set(businesses.map((business) => business.category))];

// Results are built client-side from the static index, so there is nothing
// server-rendered here for a crawler to index. The category pages are the
// indexable surface; this page is a tool, and it says so with noindex.
---

<Base
  locale={locale}
  path={ROUTES.search}
  title={`${t('search.title')} · Leamington`}
  description={t('search.placeholder')}
  footerCategories={categories}
  noindex={true}
>
  <h1 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
    {t('search.title')}
  </h1>

  {/* client:load: someone who navigated to /search is about to type. */}
  <SearchIsland client:load locale={locale} indexUrl={ROUTES.searchIndex} />

  <noscript>
    <p class="mt-4 text-ink-700">{t('search.startTyping')}</p>
    <a href={localizedPath(locale, ROUTES.directory)} class="btn-secondary mt-3">
      {t('nav.directory')}
    </a>
  </noscript>
</Base>
