---
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import ClickoutLink from '../components/ClickoutLink';
import OpenNowBadge from '../components/OpenNowBadge';
import {
  categoryMessageKey,
  formatPhone,
  formatTimeOfDay,
  pick,
  translate,
  truncate,
  INTL_LOCALES,
  type Business,
  type Locale,
  type MessageKey,
  type Offer,
} from '@leamington/shared';
import { businessJsonLd, offerJsonLd, serializeJsonLd } from '../lib/seo';
import { businessPathBare, categoryPath } from '../lib/routes';

interface Props {
  locale: Locale;
  business: Business;
  offers: Offer[];
}

const { locale, business, offers } = Astro.props;
const t = (key: MessageKey, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const site = Astro.site?.toString() ?? 'https://leamington.city';
const categoryName = t(categoryMessageKey(business.category));

const description =
  truncate(pick(business.shortDescription, locale), 160) ||
  `${business.name} — ${categoryName}, ${business.address.city}, ${business.address.province}`;

const jsonLd = [
  serializeJsonLd(businessJsonLd(business, locale, site)),
  ...offers.map((offer) => serializeJsonLd(offerJsonLd(offer, locale, site))),
];

const WEEKDAY_ORDER = [1, 2, 3, 4, 5, 6, 0];
const weekdayNames = new Intl.DateTimeFormat(INTL_LOCALES[locale], { weekday: 'long' });
---

<Base
  locale={locale}
  path={businessPathBare(business)}
  title={`${business.name} · ${categoryName} · Leamington`}
  description={description}
  image={business.heroUrl ?? business.logoUrl}
  jsonLd={jsonLd}
  ogType="business.business"
>
  <article>
    <nav class="text-sm">
      <a href={categoryPath(business.category, locale)} class="text-brand-600 underline">
        {t('business.backToCategory', { category: categoryName })}
      </a>
    </nav>

    <header class="mt-3 flex items-start gap-3">
      {
        business.logoUrl && (
          <img
            src={business.logoUrl}
            alt=""
            width="64"
            height="64"
            decoding="async"
            class="h-16 w-16 shrink-0 rounded-xl object-cover"
          />
        )
      }
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-neutral-900">{business.name}</h1>
        <p class="text-sm text-neutral-600">
          {business.address.line1}{business.address.line2 ? `, ${business.address.line2}` : ''}
          <br />
          {business.address.city}, {business.address.province}
          {business.address.postalCode ? ` ${business.address.postalCode}` : ''}
        </p>
        {/* client:load, not client:visible — this sits above the fold and is
            the single most useful fact on the page. */}
        <OpenNowBadge client:load hours={business.hours} locale={locale} className="mt-1" />
      </div>
    </header>

    {
      pick(business.description, locale) && (
        <p class="mt-4 text-neutral-800">{pick(business.description, locale)}</p>
      )
    }

    <div class="mt-5 grid gap-2">
      {
        business.websiteUrl ? (
          /* The primary CTA. Every tap is recorded to /clickouts by a Cloud
             Function before the browser leaves. */
          <ClickoutLink
            client:visible
            targetType="business"
            targetId={business.id}
            fallbackUrl={business.websiteUrl}
            locale={locale}
            source="detail"
            label={t('business.visitWebsite')}
          />
        ) : business.tier === 'stub' ? (
          /* No website and nobody has claimed it: the useful action is to ask
             the owner to take it over. */
          <a
            href={`https://portal.leamington.city/claim?business=${business.id}`}
            class="btn-primary w-full"
            rel="noopener"
          >
            {t('business.claimCta')}
          </a>
        ) : (
          <p class="rounded-lg bg-neutral-50 p-3 text-center text-sm text-neutral-500">
            {t('business.noWebsite')}
          </p>
        )
      }

      {
        business.phone && (
          <a href={`tel:${business.phone}`} class="btn-secondary">
            {t('business.call')} · {formatPhone(business.phone)}
          </a>
        )
      }
    </div>

    <PhotoGallery photos={business.photos} name={business.name} locale={locale} />

    {
      business.hours && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold text-neutral-900">{t('business.hours')}</h2>
          <dl class="mt-2 divide-y divide-neutral-100 text-sm">
            {WEEKDAY_ORDER.map((day) => {
              const intervals = business.hours?.[day] ?? [];
              // 2024-01-07 was a Sunday, so `day` indexes straight onto it.
              const label = weekdayNames.format(new Date(Date.UTC(2024, 0, 7 + day)));
              return (
                <div class="flex justify-between py-2">
                  <dt class="capitalize text-neutral-600">{label}</dt>
                  <dd class="text-neutral-900">
                    {intervals.length === 0
                      ? t('business.closedToday')
                      : intervals
                          .map(
                            (interval) =>
                              `${formatTimeOfDay(interval.open, locale)}–${formatTimeOfDay(
                                interval.close,
                                locale,
                              )}`,
                          )
                          .join(', ')}
                  </dd>
                </div>
              );
            })}
          </dl>
        </section>
      )
    }

    <MapEmbed business={business} locale={locale} />

    {
      offers.length > 0 && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold text-neutral-900">{t('offer.title')}</h2>
          <div class="mt-2 space-y-3">
            {offers.map((offer) => (
              <OfferCard offer={offer} locale={locale} showBusiness={false} />
            ))}
          </div>
        </section>
      )
    }

    {
      business.tier === 'stub' && (
        <section class="mt-8 rounded-xl bg-neutral-50 p-4">
          <p class="text-sm text-neutral-600">{t('business.unclaimedNote')}</p>
          <p class="mt-2 font-semibold text-neutral-900">{t('business.claimThis')}</p>
          <a
            href={`https://portal.leamington.city/claim?business=${business.id}`}
            class="btn-secondary mt-2 w-full"
            rel="noopener"
          >
            {t('business.claimCta')}
          </a>
        </section>
      )
    }
  </article>
</Base>
