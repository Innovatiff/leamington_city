---
import Base from '../../../layouts/Base.astro';
import OfferCard from '../../../components/OfferCard.astro';
import ClickoutLink from '../../../components/ClickoutLink';
import {
  LOCALES,
  formatPhone,
  formatTimeOfDay,
  pick,
  translate,
  truncate,
  type Business,
  type Locale,
  type Offer,
} from '@leamington/shared';
import { getBusinesses, getLiveOffers } from '../../../lib/content';
import { businessJsonLd, offerJsonLd, serializeJsonLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const [businesses, offers] = await Promise.all([getBusinesses(), getLiveOffers()]);

  // Group offers once here rather than querying per page.
  const offersByBusiness = new Map<string, Offer[]>();
  for (const offer of offers) {
    const bucket = offersByBusiness.get(offer.businessId) ?? [];
    bucket.push(offer);
    offersByBusiness.set(offer.businessId, bucket);
  }

  return LOCALES.flatMap((lang) =>
    businesses.map((business) => ({
      params: { lang, slug: business.slug },
      props: { business, offers: offersByBusiness.get(business.id) ?? [] },
    })),
  );
}

const locale = Astro.params.lang as Locale;
// Typed from getStaticPaths' props above.
const { business, offers } = Astro.props as { business: Business; offers: Offer[] };
const t = (key: Parameters<typeof translate>[1], params?: Record<string, string | number>) =>
  translate(locale, key, params);

const site = Astro.site?.toString() ?? 'https://leamington.city';
const description =
  truncate(pick(business.shortDescription, locale), 160) ||
  `${business.name}, ${business.address.city}, ${business.address.province}`;

const jsonLd = [
  serializeJsonLd(businessJsonLd(business, locale, site)),
  ...offers.map((offer) => serializeJsonLd(offerJsonLd(offer, locale, site))),
];

const WEEKDAY_ORDER = [1, 2, 3, 4, 5, 6, 0];
const weekdayNames = new Intl.DateTimeFormat(locale === 'es' ? 'es-419' : 'en-CA', {
  weekday: 'long',
});
const mapsUrl = business.geo
  ? `https://www.google.com/maps/search/?api=1&query=${business.geo.lat},${business.geo.lng}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${business.name} ${business.address.line1} ${business.address.city}`,
    )}`;
---

<Base
  locale={locale}
  path={`/business/${business.slug}`}
  title={`${business.name} · Leamington`}
  description={description}
  image={business.heroUrl ?? business.logoUrl}
  jsonLd={jsonLd}
>
  <article>
    <header class="flex items-start gap-3">
      {
        business.logoUrl && (
          <img
            src={business.logoUrl}
            alt=""
            width="64"
            height="64"
            decoding="async"
            class="h-16 w-16 shrink-0 rounded-xl object-cover"
          />
        )
      }
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-neutral-900">{business.name}</h1>
        <p class="text-sm text-neutral-600">
          {business.address.line1}
          {business.address.line2 ? `, ${business.address.line2}` : ''}
          <br />
          {business.address.city}, {business.address.province}
          {business.address.postalCode ? ` ${business.address.postalCode}` : ''}
        </p>
      </div>
    </header>

    {
      pick(business.description, locale) && (
        <p class="mt-4 text-neutral-800">{pick(business.description, locale)}</p>
      )
    }

    <div class="mt-5 grid gap-2">
      {
        business.websiteUrl ? (
          <ClickoutLink
            client:visible
            targetType="business"
            targetId={business.id}
            fallbackUrl={business.websiteUrl}
            locale={locale}
            source="detail"
            label={t('business.visitWebsite')}
          />
        ) : (
          <p class="rounded-lg bg-neutral-50 p-3 text-center text-sm text-neutral-500">
            {t('business.noWebsite')}
          </p>
        )
      }

      {
        business.phone && (
          <a href={`tel:${business.phone}`} class="btn-secondary">
            {t('business.call')} · {formatPhone(business.phone)}
          </a>
        )
      }

      <a href={mapsUrl} rel="noopener noreferrer" target="_blank" class="btn-secondary">
        {t('business.directions')}
      </a>
    </div>

    {
      business.hours && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold text-neutral-900">{t('business.hours')}</h2>
          <dl class="mt-2 divide-y divide-neutral-100 text-sm">
            {WEEKDAY_ORDER.map((day) => {
              const intervals = business.hours?.[day] ?? [];
              // 2024-01-07 was a Sunday, so `day` indexes straight onto it.
              const label = weekdayNames.format(new Date(Date.UTC(2024, 0, 7 + day)));
              return (
                <div class="flex justify-between py-2">
                  <dt class="capitalize text-neutral-600">{label}</dt>
                  <dd class="text-neutral-900">
                    {intervals.length === 0
                      ? t('business.closedToday')
                      : intervals
                          .map(
                            (interval) =>
                              `${formatTimeOfDay(interval.open, locale)}–${formatTimeOfDay(
                                interval.close,
                                locale,
                              )}`,
                          )
                          .join(', ')}
                  </dd>
                </div>
              );
            })}
          </dl>
        </section>
      )
    }

    {
      offers.length > 0 && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold text-neutral-900">{t('offer.title')}</h2>
          <div class="mt-2 space-y-3">
            {offers.map((offer) => (
              <OfferCard offer={offer} locale={locale} showBusiness={false} />
            ))}
          </div>
        </section>
      )
    }

    {
      business.tier === 'stub' && (
        <section class="mt-8 rounded-xl bg-neutral-50 p-4">
          <p class="text-sm text-neutral-600">{t('business.unclaimedNote')}</p>
          <p class="mt-2 font-semibold text-neutral-900">{t('business.claimThis')}</p>
          <a
            href={`https://portal.leamington.city/claim?business=${business.id}`}
            class="btn-secondary mt-2 w-full"
          >
            {t('business.claimCta')}
          </a>
        </section>
      )
    }
  </article>
</Base>
