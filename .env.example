# Copy to .env — the values below are the real ones for the `leamingtoncity`
# project and work as they stand.
#
# Every value here is a public Firebase Web app identifier. Google documents
# them as safe to ship in a client bundle: access control is firestore.rules,
# not secrecy. Worth doing anyway — restrict the browser key by HTTP referrer
# under Google Cloud console → APIs & Services → Credentials, so it cannot be
# reused from someone else's site.
#
# Anything genuinely secret belongs in Secret Manager, wired via `defineSecret`
# in functions/src, and never in this file.
#
# The project id also lives in .firebaserc; that is what the CLI, emulators and
# deploys read.

# --- Firebase Web app config (all three apps read these) ---------------------
# apps/app is Astro, so its vars are PUBLIC_*; apps/portal and apps/admin are
# Vite, so theirs are VITE_*. Same values, two prefixes.

PUBLIC_FIREBASE_API_KEY=AIzaSyAQgRAa8ECMyIkonsJhcNQWSz2fo-LTO0Y
PUBLIC_FIREBASE_AUTH_DOMAIN=leamingtoncity.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=leamingtoncity
PUBLIC_FIREBASE_STORAGE_BUCKET=leamingtoncity.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=909406298465
PUBLIC_FIREBASE_APP_ID=1:909406298465:web:5a27d81ebd582246af6520
PUBLIC_FIREBASE_MEASUREMENT_ID=G-VEQP4Y4KGX
# Web Push certificate key pair (Cloud Messaging → Web configuration).
# Not in the console snippet — generate it there when you turn push on.
PUBLIC_FIREBASE_VAPID_KEY=

# Analytics is OFF unless this is 1. See apps/app/src/lib/analytics.ts for why.
PUBLIC_ENABLE_ANALYTICS=0

VITE_FIREBASE_API_KEY=AIzaSyAQgRAa8ECMyIkonsJhcNQWSz2fo-LTO0Y
VITE_FIREBASE_AUTH_DOMAIN=leamingtoncity.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leamingtoncity
VITE_FIREBASE_STORAGE_BUCKET=leamingtoncity.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=909406298465
VITE_FIREBASE_APP_ID=1:909406298465:web:5a27d81ebd582246af6520

# --- Public site -------------------------------------------------------------
# Canonical origin. Required for correct sitemap, canonical and hreflang tags.
# apps/app is deployed by Netlify; set the same variables there (Site settings →
# Environment variables), since the build reads Firestore and bakes URLs in.
PUBLIC_SITE_URL=https://leamingtoncity.web.app

# --- Emulators ---------------------------------------------------------------
# Set to 1 in local development to point every client at the local emulators.
PUBLIC_USE_EMULATORS=0
VITE_USE_EMULATORS=0

# --- Server-side only (build, functions, scripts) ----------------------------
# Never prefixed with PUBLIC_/VITE_, so these are not exposed to the browser.
GOOGLE_CLOUD_PROJECT=leamingtoncity
# Path to a service-account key. Leave unset when running under `firebase
# emulators:exec` or with `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
# Emulator host for the Admin SDK used by scripts/seed.ts.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Netlify -----------------------------------------------------------------
# The build hook that functions/src/netlify.ts POSTs when business, offer or job
# data changes. This is a real secret (anyone with the URL can spend your build
# minutes), so it lives in Secret Manager, not in this file:
#   firebase functions:secrets:set NETLIFY_BUILD_HOOK_URL
