{
  "name": "leamington",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" --filter ./functions build",
    "build:shared": "pnpm --filter @leamington/shared build",
    "dev:app": "pnpm --filter @leamington/app dev",
    "dev:portal": "pnpm --filter @leamington/portal dev",
    "dev:admin": "pnpm --filter @leamington/admin dev",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start",
    "seed": "pnpm --filter @leamington/scripts seed",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "pnpm --filter @leamington/functions build && firebase deploy --only functions",
    "deploy:hosting": "pnpm --filter @leamington/portal build && pnpm --filter @leamington/admin build && firebase deploy --only hosting",
    "build:app": "pnpm build:shared && pnpm --filter @leamington/app build",
    "seed:demo": "pnpm --filter @leamington/scripts seed:demo"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
