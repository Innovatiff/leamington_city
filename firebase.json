{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["pnpm --filter @leamington/functions build"],
      "ignore": ["node_modules", ".git", "**/*.ts", "**/*.map", ".env*"]
    }
  ],
  "hosting": [
    {
      "target": "app",
      "public": "apps/app/dist",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "/en",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|webp|avif|svg)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600" }
          ]
        }
      ]
    },
    {
      "target": "portal",
      "public": "apps/portal/dist",
      "cleanUrls": true,
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "admin",
      "public": "apps/admin/dist",
      "cleanUrls": true,
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "pubsub": { "port": 8085 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
